  "summary": "DC-9 encountered severe microburst-induced windshear during final approach in thunderstorm over Charlotte. Windshear alert system failed to alert crew due to software discrepancy that lowered sensitivity while flaps in transit. Pilot attempted go-around but aircraft could not climb, descended rapidly and crashed into trees and residential street.",
  "probable_cause": "Microburst-induced windshear with contributing factors including crew's failure to recognize windshear quickly, failure to establish proper pitch and engine power during go-around, and software deficiency in windshear alert system.",
  "factors": [
    {
      "id": "windshear",
      "role": "initiating",
      "evidence": "microburst generated by thunderstorm over airport caused severe wind shear"
    },
    {
      "id": "convective_weather",
      "role": "contributing",
      "evidence": "severe thunderstorms in vicinity of airport with heavy rain"
    },
    {
      "id": "warning_system_deficiency",
      "role": "contributing",
      "evidence": "windshear alert system had software discrepancy that lowered sensitivity while flaps were in transit, alert not provided 8-9 seconds prior to impact"
    },
    {
      "id": "inadequate_monitoring",
      "role": "contributing",
      "evidence": "crew failed to recognize wind shear quickly due to alert system error and inadequate weather information"
    },
    {
      "id": "cfit",
      "role": "outcome",
      "evidence": "aircraft crashed through airport fence and impacted trees, skidding down residential street"
    }
  ],
