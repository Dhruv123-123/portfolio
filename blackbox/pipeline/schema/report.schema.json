{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blackbox accident record",
  "type": "object",
  "required": ["id", "title", "date", "agency", "agencies", "aircraft", "operator", "phase", "summary", "probable_cause", "factors", "chain", "events", "recommendations", "extraction"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string" },
    "flight_number": { "type": ["string", "null"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time_reference": { "type": "string" },
    "t0": { "type": ["string", "null"] },
    "agency": { "type": "string" },
    "agencies": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["code", "role"], "properties": {
      "code": { "type": "string" }, "name": { "type": "string" }, "country": { "type": "string" },
      "role": { "type": "string", "enum": ["lead", "accredited_representative", "participant", "commenting", "delegated", "assisting"] },
      "report_id": { "type": ["string", "null"] }, "report_title": { "type": ["string", "null"] }, "report_date": { "type": ["string", "null"] }, "url": { "type": ["string", "null"] } } } },
    "aircraft": { "type": "object", "required": ["type", "manufacturer"], "properties": { "type": { "type": "string" }, "family": { "type": "string" }, "manufacturer": { "type": "string" }, "registration": { "type": ["string", "null"] }, "msn": { "type": ["string", "null"] }, "engines": { "type": ["string", "null"] } } },
    "operator": { "type": "string" },
    "route": { "type": "object" },
    "location": { "type": "object", "properties": { "name": { "type": "string" }, "country": { "type": "string" }, "lat": { "type": ["number", "null"] }, "lon": { "type": ["number", "null"] } } },
    "phase": { "type": "string" },
    "occupants": { "type": ["integer", "null"] }, "fatalities": { "type": ["integer", "null"] }, "injuries_serious": { "type": ["integer", "null"] },
    "damage": { "type": "string", "enum": ["destroyed", "substantial", "minor", "none"] },
    "category": { "type": "string" },
    "summary": { "type": "string" },
    "probable_cause": { "type": "string" },
    "factors": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "role"], "properties": { "id": { "type": "string" }, "role": { "type": "string", "enum": ["initiating", "contributing", "latent", "outcome"] }, "evidence": { "type": "string" } } } },
    "chain": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
    "events": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["t", "text", "actor"], "properties": { "t": { "type": "number" }, "clock": { "type": ["string", "null"] }, "phase": { "type": "string" }, "actor": { "type": "string" }, "text": { "type": "string" }, "state": { "type": "object" }, "factors": { "type": "array", "items": { "type": "string" } }, "kind": { "type": "string", "enum": ["system", "crew_action", "crew_speech", "atc", "env", "outcome", "warning"] } } } },
    "cvr": { "type": "array", "items": { "type": "object", "required": ["t", "speaker", "text"], "properties": { "t": { "type": "number" }, "clock": { "type": ["string", "null"] }, "speaker": { "type": "string" }, "text": { "type": "string" }, "translation": { "type": ["string", "null"] } } } },
    "recommendations": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "id": { "type": ["string", "null"] }, "to": { "type": ["string", "null"] }, "text": { "type": "string" }, "status": { "type": "string", "enum": ["open", "closed_acceptable", "closed_unacceptable", "superseded", "unknown"] }, "outcome": { "type": ["string", "null"] }, "trigger_factors": { "type": "array", "items": { "type": "string" } } } } },
    "dissent": { "type": "array", "items": { "type": "object", "required": ["agency", "position"], "properties": { "agency": { "type": "string" }, "position": { "type": "string" }, "topic": { "type": "string" } } } },
    "safety_changes": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } },
    "fdr": { "type": ["string", "null"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "extraction": { "type": "object", "required": ["method", "confidence"], "properties": { "method": { "type": "string" }, "model": { "type": "string" }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] }, "reviewed": { "type": "boolean" }, "notes": { "type": "array", "items": { "type": "string" } } } }
  }
}
