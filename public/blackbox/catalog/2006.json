[{"id":"wd_q2202322","qid":"Q2202322","tier":"wikidata","depth":"summary","title":"S7 Airlines 778","flight_number":null,"date":"2006-07-09","agency":"UNKNOWN","agencies":null,"aircraft":{"type":"Airbus A310","manufacturer":"Airbus","family":"310","registration":null},"operator":"unknown","route":{"from_name":"Domodedovo International Airport","to_name":"Irkutsk International Airport"},"location":{"name":"Irkutsk International Airport","country":"Russia"},"phase":"approach","occupants":203,"fatalities":125,"category":"UNK","summary":"[Accident] Immediately after the touch down, Captain Shibanov armed the spoilers and engaged the aircraft's autobrake to low mode. The reverse throttle lever of the right engine was then pulled to the maximum level to slow down the aircraft. The reverse lever of the left engine, however, was left untouched.","probable_cause":"cause of the crash was attributed to pilot error.","factors":[{"id":"runway_overrun","role":"outcome","evidence":"On 9 July 2006, at 06:44 local time (8 July, 22:44 UTC), the Airbus A310 aircraft operating the route overran the runway during its landing in Irkutsk."},{"id":"atc_communication_error","role":"contributing","evidence":"They contacted the on-duty controller and obtained clearance to descend to 5,700 meters."},{"id":"convective_weather","role":"contributing","evidence":"The report stated that the visibility was 3,500 meters, surface wind at 4 m/s, increase in cloud base height from 170 meters to 190 meters, light torrential rain and cumulonimbus-covered sky."},{"id":"deicing_inadequate","role":"contributing","evidence":"During the descent, the crew elected to turn on the engines' anti-icing system."},{"id":"delayed_deceleration","role":"contributing","evidence":"Captain Shibanov then pushed the right engine reverse thrust to decrease the rate of deceleration."},{"id":"deliberate_act","role":"contributing","evidence":"While the captain was reducing the thrust reverser of the right engine, he unintentionally moved the left engine's throttle lever forward, causing the left engine to produce significant thrust."},{"id":"dual_engine_failure","role":"contributing","evidence":"They eventually established the glidepath and then carried out the landing checklist."},{"id":"inadequate_monitoring","role":"contributing","evidence":"His co-pilot failed to monitor the engine parameters and as a result the crew were unable to realize the source of the problem."},{"id":"inadequate_training","role":"contributing","evidence":"He had undergone a conversion training in April 2006 and was subsequently appointed as a co-pilot of the Airbus A310 in May."},{"id":"low_energy_state","role":"contributing","evidence":"The reverse throttle lever of the right engine was then pulled to the maximum level to slow down the aircraft."}],"chain":[["runway_overrun","low_energy_state"],["atc_communication_error","low_energy_state"]],"events":[{"t":0,"clock":null,"phase":"takeoff","actor":"SYS","kind":"system","text":"Aircraft departed runway","factors":[]},{"t":300,"clock":null,"phase":"initial_climb","actor":"SYS","kind":"system","text":"Initial climb phase","factors":[]},{"t":600,"clock":null,"phase":"cruise","actor":"SYS","kind":"system","text":"En route","factors":[]},{"t":900,"clock":null,"phase":"descent","actor":"SYS","kind":"system","text":"Aircraft descending to destination","factors":[]},{"t":1200,"clock":null,"phase":"approach","actor":"SYS","kind":"system","text":"Approach procedure commenced","factors":[]},{"t":1500,"clock":null,"phase":"landing","actor":"SYS","kind":"system","text":"Landing attempted","factors":[]},{"t":1800,"clock":null,"phase":"unknown","actor":"SYS","kind":"outcome","text":"Aircraft crash","factors":[]}],"report_links":["https://www.bea.aero/docspa/2006/f-yp060708a/pdf/f-yp060708a.pdf","https://web.archive.org/web/20110531151937/http://www.bea.aero/docspa/2006/f-yp060708a/pdf/f-yp060708a.pdf","https://mak-iac.org/en/rassledovaniya/09-iyulya-a310-f-ogyp/","https://mak-ia