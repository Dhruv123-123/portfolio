[{"id":"wd_q1153249","qid":"Q1153249","tier":"wikidata","depth":"summary","title":"Kenya Airways 431","flight_number":null,"date":"2000-01-30","agency":"UNKNOWN","agencies":null,"aircraft":{"type":"Airbus A310","manufacturer":"Airbus","family":"310","registration":null},"operator":"Kenya Airways","route":{"from_name":"Port Bouet Airport","to_name":"Jomo Kenyatta International Airport"},"location":null,"phase":"approach","occupants":179,"fatalities":169,"category":"UNK","summary":"[Accident] The flight originated in Nairobi as Flight KQ430, and was due to land in Abidjan after a stopover in Lagos. Many Nigerians who travelled to Dubai for duty-free shopping used this flight. On that day, after being held over Lagos, the flight continued directly to Abidjan because of poor local weather conditions.","probable_cause":"caused by the flight crew's improper response following the activation of a false stall warning.","factors":[{"id":"aerodynamic_stall","role":"outcome","evidence":"The investigation concluded that the crash was caused by the flight crew's improper response following the activation of a false stall warning."},{"id":"emergency_landing","role":"outcome","evidence":"Only ten people survived."},{"id":"altimeter_setting_error","role":"contributing","evidence":"The Ground proximity warning system (GPWS) then sounded briefly, though the radio altimeter sent out warnings seconds after, cutting off the GPWS warning."},{"id":"atc_communication_error","role":"contributing","evidence":"The Ministry of Transport of the Ivory Coast published the original French-language accident report and the BEA published its English version of the report."},{"id":"dark_night","role":"contributing","evidence":"On 30 January 2000, the Airbus A310 serving the flight crashed into the sea off the Ivory Coast, shortly after takeoff at night from Félix-Houphouët-Boigny International Airport, Abidjan."},{"id":"excessive_speed","role":"contributing","evidence":"The master warning then sounded, indicating that the aircraft was overspeeding, at which point captain Muthee shouted, \"go up,\" but the aircraft was descending too quickly to recover."},{"id":"gpws_warning_response","role":"contributing","evidence":"The Ground proximity warning system (GPWS) then sounded briefly, though the radio altimeter sent out warnings seconds after, cutting off the GPWS warning."},{"id":"inadequate_monitoring","role":"contributing","evidence":"The following elements contributed to the accident: \nthe pilot flying's action on the control column put the airplane into a descent without the crew realizing it, despite the radio altimeter callouts"},{"id":"inadequate_training","role":"contributing","evidence":"In the aftermath of the crash, the BEA issued recommendations for better training for pilots in terms of handling a false stall warning."},{"id":"inappropriate_stall_recovery","role":"contributing","evidence":"During the course of the investigation, BEA had also learned of new stall recovery procedure(s), stating that such procedure(s) would be included in future flight operation manuals."}],"chain":[["aerodynamic_stall","inappropriate_stall_recovery"],["emergency_landing","inappropriate_stall_recovery"]],"events":[{"t":0,"clock":null,"phase":"takeoff","actor":"SYS","kind":"system","text":"Aircraft departed runway","factors":[]},{"t":300,"clock":null,"phase":"initial_climb","actor":"SYS","kind":"system","text":"Initial climb phase","factors":[]},{"t":600,"clock":null,"phase":"cruise","actor":"SYS","kind":"system","text":"En route","factors":[]},{"t":900,"clock":null,"phase":"descent","actor":"SYS","kind":"system","text":"Aircraft descending to destination","factors":[]},{"t":1200,"clock":null,"phase":"approach","actor":"SYS","kind":"system","text":"Approach procedure commenced","factors":[]},{"t":1500,"clock":null,"phase":"landing","actor":"SYS","kind":"system","text":"Landing attempted","factors":[]},{"t":1800,"clock":null,"phase":"unknown","actor":"SYS","kind":"outcome"