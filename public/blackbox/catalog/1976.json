[{"id":"wd_q7388498","qid":"Q7388498","tier":"wikidata","depth":"summary","title":"SAETA 232","flight_number":"SA232","date":"1976-08-15","agency":"MAK","aircraft":{"type":"Vickers Viscount","manufacturer":"Vickers","family":"Viscount","registration":null},"operator":"SAETA","route":{"from_name":"Old Mariscal Sucre International Airport","to_name":"Mariscal Lamar International Airport"},"phase":"climb","occupants":59,"fatalities":59,"category":"SEC","summary":"SAETA Flight 011 was a scheduled passenger flight operated by SAETA Air Ecuador between Quito and Cuenca, using a Vickers Viscount 785D aircraft. On 15 August 1976, the flight was reported missing near the Chimborazo stratovolcano while carrying 55 passengers and four crew members. Searches for the plane would be carried out for 26 years, until the wreckage of the aircraft was officially located in February 2003.","probable_cause":"Speculation surrounding the existence of the flight data recorder (FDR) and the cockpit voice recorder (CVR), the discovery of the plane's remains, as there is no certainty as to whether the plane carried both or either device. In this line, the DAC stated that no black boxes were aboard the airc...","factors":[{"id":"fatigue","role":"contributing","evidence":"Text mentions tired"},{"id":"dark_night","role":"contributing","evidence":"Text mentions night"},{"id":"navigation_error","role":"contributing","evidence":"Text mentions off course"},{"id":"terrorism_or_hostile_act","role":"initiating","evidence":"Text mentions hijack"},{"id":"loss_of_control_inflight","role":"outcome","evidence":"Accident resulted from aircraft losing control or structural failure"}],"chain":[["fatigue","loss_of_control_inflight"],["dark_night","loss_of_control_inflight"]],"events":[{"t":0,"clock":null,"phase":"takeoff","actor":"CAPT","kind":"crew_action","text":"Aircraft in takeoff phase","factors":[]},{"t":30,"clock":null,"phase":"initial_climb","actor":"CAPT","kind":"crew_action","text":"Climb","factors":[